---
// Throwaway prototype: scroll-scrubbed render sequence.
// Standalone on purpose — no BaseLayout, no global styles, no nav.
//
// Inputs (all under public/lab/scroll-test/):
//   frames/{desktop,mobile}/<frame>.webp + frames/manifest.json  <- node scripts/convert-frames.mjs
//   cards/<slug>.webp                                            <- same script (src/pages/lab/hotspots/*.png)
//   hotspots.json                                                <- scripts/blender/export-hotspots.py
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Lab — scroll test</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;1,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main class="scroller" id="scroller">
      <div class="stage" id="stage">
        <canvas id="canvas" aria-label="Scroll-driven render sequence"></canvas>
        <!-- Film grain: over the art, under hotspots/cards (and the rail, which is outside the stage). -->
        <canvas class="grain" id="grain" aria-hidden="true"></canvas>
        <div class="hotspots" id="hotspots"></div>
      </div>
    </main>

    <!-- Right-hand progress line: dim track, bright fill up to the current frame, one circle per hotspot. -->
    <div class="rail" id="rail">
      <div class="rail__track" aria-hidden="true"></div>
      <div class="rail__fill" id="railFill" aria-hidden="true"></div>
      <div class="rail__stops" id="railStops"></div>
    </div>

    <pre class="hud" id="hud">loading…</pre>

    <style is:global>
      :root {
        /* DESIGN.md poles, inverted for a dark stage */
        --bg: #1a1a1a;
        --text: #f5f2ed;
        --mid: #888888;
        --accent: #efef0c;
        --accent-dim: rgba(239, 239, 12, 0.22);
        --accent-glow: rgba(239, 239, 12, 0.65);
        --ease: cubic-bezier(0.4, 0, 0.2, 1);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        background: var(--bg);
        scrollbar-width: none; /* replaced by the custom rail */
      }
      html::-webkit-scrollbar {
        display: none;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: 'Space Mono', ui-monospace, monospace;
        font-size: 11px;
        letter-spacing: 0.03em;
      }

      /* Scroll length (~3.5vh per frame for 401 frames). Tune to taste. */
      .scroller {
        height: 1400vh;
      }

      .stage {
        position: sticky;
        top: 0;
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
        background: var(--bg);
      }

      #canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
      }

      /* ---- hotspot dots on the art ---- */
      .hotspots {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .hotspot {
        position: absolute;
        left: 0;
        top: 0;
        width: 0;
        height: 0;
        padding: 0;
        border: 0;
        background: none;
        color: var(--text);
        font: inherit;
        letter-spacing: inherit;
        opacity: 0;
        pointer-events: none;
        cursor: pointer;
        transition: opacity 200ms var(--ease);
        will-change: transform;
      }
      .hotspot.is-visible {
        opacity: 1;
        pointer-events: auto;
      }
      /* generous hit area around the 16px dot */
      .hotspot::before {
        content: '';
        position: absolute;
        left: -24px;
        top: -24px;
        width: 48px;
        height: 48px;
        border-radius: 50%;
      }
      .hotspot__dot {
        position: absolute;
        left: -8px;
        top: -8px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2px solid var(--accent);
        background: transparent;
        box-shadow: 0 0 8px 1px var(--accent-glow);
        transition: background-color 300ms var(--ease), transform 200ms var(--ease);
      }
      .hotspot.is-passed .hotspot__dot {
        background: var(--accent);
      }
      .hotspot:hover .hotspot__dot,
      .hotspot:focus-visible .hotspot__dot {
        transform: scale(1.25);
      }
      .hotspot:focus-visible {
        outline: none;
      }
      .hotspot__dot::after {
        content: '';
        position: absolute;
        inset: -8px;
        border: 1px solid var(--accent);
        border-radius: 50%;
        opacity: 0.5;
        animation: hotspot-pulse 2.4s var(--ease) infinite;
      }
      .hotspot__label {
        position: absolute;
        left: 20px;
        top: -8px;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        text-shadow: 0 0 6px var(--bg), 0 0 2px var(--bg);
      }
      @keyframes hotspot-pulse {
        0% {
          transform: scale(0.6);
          opacity: 0.7;
        }
        100% {
          transform: scale(1.8);
          opacity: 0;
        }
      }

      /* ---- film grain (canvas, see script) ---- */
      .grain {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        opacity: 0.19;
        mix-blend-mode: hard-light;
      }

      /* ---- progress rail ---- */
      .rail {
        position: fixed;
        top: 24px;
        bottom: 24px;
        right: 8px;
        width: 32px;
        z-index: 10;
        cursor: pointer;
        touch-action: none;
      }
      .rail__track,
      .rail__fill {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 2px;
        margin-left: -1px;
      }
      .rail__track {
        background: var(--accent-dim);
      }
      .rail__fill {
        background: var(--accent);
        box-shadow: 0 0 8px 1px var(--accent-glow), 0 0 22px 2px rgba(239, 239, 12, 0.3);
        transform-origin: top;
        transform: scaleY(0);
        will-change: transform;
      }
      .rail__stops {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      /* hollow circle (the line is masked behind it) that fills once passed */
      .rail__stop {
        position: absolute;
        left: 50%;
        width: 16px;
        height: 16px;
        margin: -8px 0 0 -8px;
        padding: 0;
        border: 2px solid var(--accent);
        border-radius: 50%;
        background: var(--bg);
        color: var(--accent);
        font: inherit;
        cursor: pointer;
        pointer-events: auto;
        transition: background-color 300ms var(--ease), box-shadow 300ms var(--ease), transform 200ms var(--ease);
      }
      .rail__stop.is-passed {
        background: var(--accent);
        box-shadow: 0 0 10px 2px var(--accent-glow);
      }
      .rail__stop:hover,
      .rail__stop:focus-visible {
        transform: scale(1.25);
        outline: none;
      }
      .rail__label {
        position: absolute;
        right: 26px;
        top: 50%;
        transform: translateY(-50%);
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--text);
        text-shadow: 0 0 6px var(--bg), 0 0 2px var(--bg);
        opacity: 0;
        pointer-events: none;
        transition: opacity 200ms var(--ease);
      }
      .rail__stop:hover .rail__label,
      .rail__stop:focus-visible .rail__label {
        opacity: 1;
      }

      /* ---- lore cards, pinned in the scene next to their dot ---- */
      .lore {
        position: absolute;
        left: 0;
        top: 0;
        pointer-events: none;
        will-change: transform;
      }
      .lore__line {
        position: absolute;
        height: 1px;
        transform-origin: 0 50%;
        background: linear-gradient(90deg, var(--accent), rgba(239, 239, 12, 0.15));
        box-shadow: 0 0 6px var(--accent-glow);
        opacity: 0;
        transition: opacity 300ms var(--ease);
      }
      .lore__pose {
        /* per-frame perspective tilt is set inline; no transition here */
        transform-style: flat;
      }
      .lore__pop {
        opacity: 0;
        transform: scale(0.55) rotateY(var(--pop-spin, 40deg));
        transition: opacity 250ms var(--ease), transform 450ms cubic-bezier(0.2, 0.9, 0.25, 1.1);
      }
      .lore__img {
        display: block;
        width: 100%;
        height: auto;
        box-shadow: 0 0 0 1px var(--accent-dim), 0 0 30px rgba(239, 239, 12, 0.18), 0 12px 40px rgba(0, 0, 0, 0.55);
      }
      .lore.is-open .lore__line {
        opacity: 1;
      }
      .lore.is-open .lore__pop {
        opacity: 1;
        transform: scale(1) rotateY(0deg);
      }
      .lore.is-open .lore__pose {
        pointer-events: auto;
        cursor: pointer;
      }

      /* ---- debug HUD ---- */
      .hud {
        position: fixed;
        left: 16px;
        bottom: 16px;
        z-index: 10;
        margin: 0;
        padding: 8px;
        font: inherit;
        line-height: 1.6;
        color: var(--text);
        background: rgba(26, 26, 26, 0.7);
        pointer-events: none;
      }
      .hud b {
        font-weight: 400;
        color: var(--mid);
      }

      @media (max-width: 768px) {
        .rail {
          right: 0;
          width: 28px;
        }
        .rail__label,
        .hotspot__label {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hotspot__dot::after {
          animation: none;
        }
        .lore__pop,
        .lore__line {
          transition: none;
        }
        .hotspot,
        .hotspot__dot,
        .rail__stop,
        .rail__label {
          transition: none;
        }
      }
    </style>

    <script>
      type Manifest = {
        frames: string[]; // zero-padded Blender frame ids, playback order
        variants: Record<string, { width: number; height: number }>;
      };
      type Spot = { x: number; y: number; depth?: number; visible: boolean; occluded?: boolean | null };
      type HotspotFile = { frames: Record<string, Record<string, Spot>> };
      type Hotspot = {
        name: string;
        card: string;
        frame: number; // Blender frame where the rail circle sits / counts as "passed"
        index: number; // resolved position in manifest.frames
        track: { x: number; y: number; depth: number; visible: boolean }[]; // per manifest frame
        dot: HTMLButtonElement;
        stop: HTMLButtonElement;
        lore: HTMLElement;
        pose: HTMLElement;
        pop: HTMLElement;
        line: HTMLElement;
        passed: boolean;
        open: boolean;
      };

      // -------- config --------

      // Hotspots with lore cards. `name` = Blender empty name, `card` = file in cards/,
      // `frame` = where it sits on the rail (and when it flips from outline to filled).
      // Frames = the last frame each empty is in view (from hotspots.json), i.e. the moment the
      // camera has gone past it. Nudge freely if a different beat feels right.
      const HOTSPOTS = [
        { name: 'Researchers', card: 'researchers', frame: 324 },
        { name: 'Orb Lore', card: 'orb-lore', frame: 355 },
        { name: 'Geometry Lore', card: 'geometry-lore', frame: 296 },
      ];

      const HIDE_OCCLUDED = false; // honour the raycast flag from the Blender export
      const SMOOTHING = 0.18; // 1 = no easing between scroll target and drawn frame
      const FETCH_CONCURRENCY = 6;
      const MAX_DECODES = 4;
      const ANCHOR_STEP = 25; // frames kept decoded permanently as a fallback while scrubbing fast
      const WINDOW = 18; // frames decoded either side of the current one

      const ROOT = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/lab/scroll-test`;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const mobileQuery = window.matchMedia('(max-width: 768px)');

      const $ = (id: string) => document.getElementById(id)!;
      const scroller = $('scroller');
      const stage = $('stage');
      const canvas = $('canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;
      ctx.imageSmoothingQuality = 'high';
      const hotspotLayer = $('hotspots');
      const rail = $('rail');
      const railFill = $('railFill');
      const railStops = $('railStops');
      const hud = $('hud');

      // -------- state --------

      let manifest: Manifest;
      let variant = '';
      let hotspotFile: HotspotFile | null = null;
      const hotspots: Hotspot[] = [];

      // Compressed bytes for every frame (cheap) vs decoded bitmaps for a window (expensive).
      let blobs: (Blob | null)[] = [];
      let blobCount = 0;
      const bitmaps = new Map<number, ImageBitmap>();
      const inflight = new Set<number>();
      let wanted = new Set<number>();
      let decoding = 0;
      let loadToken = 0; // bumps on variant change, cancelling the old queue

      let progress = 0; // 0–1 scroll progress
      let current = 0; // eased frame position (float index)
      let lastIndex = 0;
      let drawn = -1;
      let dirty = true;
      let cover = { x: 0, y: 0, w: 0, h: 0 }; // image rect in CSS px — shared by canvas + hotspots

      // -------- loading --------

      function anchorList(n: number): number[] {
        const out: number[] = [];
        for (let i = 0; i < n; i += ANCHOR_STEP) out.push(i);
        if (out[out.length - 1] !== n - 1) out.push(n - 1);
        return out;
      }

      function startLoading(next: string) {
        variant = next;
        const token = ++loadToken;
        const n = manifest.frames.length;

        for (const bm of bitmaps.values()) bm.close();
        bitmaps.clear();
        inflight.clear();
        decoding = 0;
        blobs = new Array(n).fill(null);
        blobCount = 0;
        dirty = true;

        // Anchors first (so something is always drawable), then outward from where the user is.
        const anchors = anchorList(n);
        const rest = [...Array(n).keys()].filter((i) => !anchors.includes(i));
        rest.sort((a, b) => Math.abs(a - lastIndex) - Math.abs(b - lastIndex));
        const queue = [...anchors, ...rest];

        const worker = async () => {
          while (queue.length && token === loadToken) {
            const i = queue.shift()!;
            try {
              const res = await fetch(`${ROOT}/frames/${next}/${manifest.frames[i]}.webp`);
              if (!res.ok) continue; // missing frame: nearest decoded one is drawn instead
              const blob = await res.blob();
              if (token !== loadToken) return;
              blobs[i] = blob;
              blobCount++;
            } catch {
              /* network hiccup: skip */
            }
          }
        };
        for (let i = 0; i < FETCH_CONCURRENCY; i++) worker();
      }

      // Keep decoded bitmaps for the current window + anchors; close the rest.
      function pump(index: number) {
        const n = manifest.frames.length;
        const want: number[] = [];
        const seen = new Set<number>();
        const add = (i: number) => {
          if (i >= 0 && i < n && !seen.has(i)) {
            seen.add(i);
            want.push(i);
          }
        };
        for (let d = 0; d <= WINDOW; d++) {
          add(index + d);
          add(index - d);
        }
        anchorList(n).forEach(add);
        wanted = seen;

        for (const [i, bm] of bitmaps) {
          if (!seen.has(i)) {
            bm.close();
            bitmaps.delete(i);
          }
        }

        const token = loadToken;
        for (const i of want) {
          if (decoding >= MAX_DECODES) break;
          if (bitmaps.has(i) || inflight.has(i) || !blobs[i]) continue;
          inflight.add(i);
          decoding++;
          createImageBitmap(blobs[i]!)
            .then((bm) => {
              if (token !== loadToken || !wanted.has(i)) return bm.close();
              bitmaps.set(i, bm);
              if (Math.abs(i - lastIndex) <= 2) dirty = true;
            })
            .catch(() => {})
            .finally(() => {
              if (token !== loadToken) return;
              inflight.delete(i);
              decoding--;
            });
        }
      }

      function nearestBitmap(i: number): number {
        if (bitmaps.has(i)) return i;
        for (let d = 1; d < manifest.frames.length; d++) {
          if (bitmaps.has(i - d)) return i - d;
          if (bitmaps.has(i + d)) return i + d;
        }
        return -1;
      }

      // -------- layout --------

      function resize() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(stage.clientWidth * dpr);
        canvas.height = Math.round(stage.clientHeight * dpr);

        // Cover-fit: scale the frame to fill the stage, centred, cropping the overflow.
        // Dots use this same rect, which is what keeps them locked to the art.
        const size = manifest.variants[variant] ?? Object.values(manifest.variants)[0];
        const cw = stage.clientWidth;
        const ch = stage.clientHeight;
        const scale = Math.max(cw / size.width, ch / size.height);
        const w = size.width * scale;
        const h = size.height * scale;
        cover = { x: (cw - w) / 2, y: (ch - h) / 2, w, h };
        dirty = true;
      }

      function scrollMax() {
        return scroller.offsetHeight - window.innerHeight;
      }

      function readProgress() {
        const max = scrollMax();
        progress = max > 0 ? Math.min(1, Math.max(0, (window.scrollY - scroller.offsetTop) / max)) : 0;
      }

      function scrollToProgress(p: number, smooth = false) {
        window.scrollTo({
          top: scroller.offsetTop + p * scrollMax(),
          behavior: smooth && !reduceMotion.matches ? 'smooth' : 'instant',
        });
      }

      // -------- hotspot data --------

      // Per-frame screen positions for one empty. The Blender export may only cover
      // some frames (e.g. every 7th), so anything missing is interpolated between
      // the nearest exported frames. Exact exports pass straight through.
      function buildTrack(name: string): Hotspot['track'] {
        const keyed: { f: number; s: Spot }[] = [];
        for (const [f, entry] of Object.entries(hotspotFile?.frames ?? {})) {
          if (entry[name]) keyed.push({ f: Number(f), s: entry[name] });
        }
        keyed.sort((a, b) => a.f - b.f);
        if (!keyed.length) return manifest.frames.map(() => ({ x: 0, y: 0, depth: 1, visible: false }));

        const flag = (s: Spot) => s.visible && !(HIDE_OCCLUDED && s.occluded);
        return manifest.frames.map((id) => {
          const f = Number(id);
          let hi = keyed.findIndex((k) => k.f >= f);
          // Past the last exported frame: hold the last position rather than extrapolate off the art.
          if (hi === -1) {
            const last = keyed[keyed.length - 1];
            return { x: last.s.x, y: last.s.y, depth: last.s.depth ?? 1, visible: flag(last.s) };
          }
          const b = keyed[hi];
          const a = keyed[Math.max(0, hi - 1)];
          if (a === b || b.f === f) return { x: b.s.x, y: b.s.y, depth: b.s.depth ?? 1, visible: flag(b.s) };
          if (f < a.f) return { x: a.s.x, y: a.s.y, depth: a.s.depth ?? 1, visible: flag(a.s) };
          const t = (f - a.f) / (b.f - a.f);
          return {
            x: a.s.x + (b.s.x - a.s.x) * t,
            y: a.s.y + (b.s.y - a.s.y) * t,
            depth: (a.s.depth ?? 1) + ((b.s.depth ?? 1) - (a.s.depth ?? 1)) * t,
            // Off-screen / behind-camera coordinates are junk, so only show when both ends are valid.
            visible: flag(a.s) && flag(b.s),
          };
        });
      }

      function nearestIndex(frame: number): number {
        let best = 0;
        manifest.frames.forEach((id, i) => {
          if (Math.abs(Number(id) - frame) < Math.abs(Number(manifest.frames[best]) - frame)) best = i;
        });
        return best;
      }

      function buildHotspots() {
        const n = manifest.frames.length;
        for (const cfg of HOTSPOTS) {
          const index = nearestIndex(cfg.frame);

          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'hotspot';
          dot.tabIndex = -1;
          dot.setAttribute('aria-label', `${cfg.name} — open lore card`);
          dot.innerHTML = `<span class="hotspot__dot"></span><span class="hotspot__label"></span>`;
          dot.querySelector('.hotspot__label')!.textContent = cfg.name;
          dot.setAttribute('aria-expanded', 'false');
          hotspotLayer.append(dot);

          // The card: .lore is positioned per frame; .pose carries the perspective tilt; .pop animates open/close.
          const lore = document.createElement('div');
          lore.className = 'lore';
          lore.innerHTML =
            `<div class="lore__line"></div><div class="lore__pose"><div class="lore__pop"><img class="lore__img" alt="" draggable="false"></div></div>`;
          const img = lore.querySelector('img')!;
          img.alt = cfg.name;
          img.src = `${ROOT}/cards/${cfg.card}.webp`;
          hotspotLayer.append(lore);

          const stop = document.createElement('button');
          stop.type = 'button';
          stop.className = 'rail__stop';
          stop.style.top = `${(index / (n - 1)) * 100}%`;
          stop.setAttribute('aria-label', `${cfg.name} — jump to frame ${manifest.frames[index]}`);
          stop.innerHTML = `<span class="rail__label"></span>`;
          stop.querySelector('.rail__label')!.textContent = cfg.name;
          stop.addEventListener('pointerdown', (e) => e.stopPropagation()); // don't start a rail drag
          stop.addEventListener('click', () => scrollToProgress(index / (n - 1), true));
          railStops.append(stop);

          const h: Hotspot = {
            ...cfg,
            index,
            track: buildTrack(cfg.name),
            dot,
            stop,
            lore,
            pose: lore.querySelector('.lore__pose') as HTMLElement,
            pop: lore.querySelector('.lore__pop') as HTMLElement,
            line: lore.querySelector('.lore__line') as HTMLElement,
            passed: false,
            open: false,
          };
          dot.addEventListener('click', () => setOpen(h, !h.open));
          lore.querySelector('.lore__pose')!.addEventListener('click', () => setOpen(h, false));
          hotspots.push(h);
        }
      }

      // -------- lore cards --------

      function setOpen(h: Hotspot, open: boolean) {
        if (open) for (const other of hotspots) if (other !== h) setOpen(other, false); // one at a time
        if (h.open === open) return;
        h.open = open;
        h.lore.classList.toggle('is-open', open);
        h.dot.setAttribute('aria-expanded', String(open));
      }
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') hotspots.forEach((h) => setOpen(h, false));
      });
      // Click anywhere that isn't a dot or a card to dismiss.
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.hotspot, .lore__pose, .rail')) hotspots.forEach((h) => setOpen(h, false));
      });

      const CARD_ASPECT = 962 / 1920;
      const CARD_MAX_TILT = 26; // degrees of perspective tilt at the stage edge

      // Where the card sits and how it's posed, from the dot's screen position and depth.
      // This is the single place to swap in projected plane corners (matrix3d) later.
      function layoutCard(h: Hotspot, px: number, py: number, depth: number) {
        const sw = stage.clientWidth;
        const sh = stage.clientHeight;
        const railRoom = 48; // keep clear of the progress line
        const narrow = sw < 768;
        const base = Math.min(Math.max(sw * 0.4, 300), 640);
        const nearness = Math.min(1.35, Math.max(0.7, 7 / Math.max(depth, 0.5))); // closer to camera = bigger
        // Phones: use the full readable width instead of depth scaling.
        const w = narrow ? sw - railRoom - 16 : Math.min(base * nearness, sw - railRoom - 16);
        const ht = w * CARD_ASPECT;
        const gap = 30;

        let x: number;
        let y: number;
        if (px + gap + w <= sw - railRoom) {
          x = px + gap;
          y = py - ht / 2;
        } else if (px - gap - w >= 8) {
          x = px - gap - w;
          y = py - ht / 2;
        } else {
          x = Math.min(Math.max(px - w / 2, 8), sw - railRoom - w);
          y = py - gap - ht >= 8 ? py - gap - ht : py + gap;
        }
        y = Math.min(Math.max(y, 8), sh - ht - 8);

        // Tilt toward the middle of the frame so it reads as a panel standing in the scene.
        const cx = x + w / 2;
        const cy = y + ht / 2;
        const ry = reduceMotion.matches ? 0 : ((cx - sw / 2) / (sw / 2)) * CARD_MAX_TILT;
        const rx = reduceMotion.matches ? 0 : -((cy - sh / 2) / (sh / 2)) * (CARD_MAX_TILT * 0.5);
        return { x, y, w, ht, ry, rx };
      }

      // -------- per-frame update --------

      function draw(index: number): boolean {
        const shown = nearestBitmap(index);
        if (shown < 0) return false;
        const k = canvas.width / stage.clientWidth;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(bitmaps.get(shown)!, cover.x * k, cover.y * k, cover.w * k, cover.h * k);
        return true;
      }

      function updateHotspots(index: number) {
        for (const h of hotspots) {
          const t = h.track[index];
          const px = cover.x + t.x * cover.w;
          const py = cover.y + t.y * cover.h;
          // "In frame" in Blender isn't "on screen" once cover-fit crops the sides, so check the stage too.
          const show = t.visible && px >= 8 && px <= stage.clientWidth - 8 && py >= 8 && py <= stage.clientHeight - 8;
          h.dot.classList.toggle('is-visible', show);
          h.dot.tabIndex = show ? 0 : -1;
          h.dot.style.transform = `translate(${px.toFixed(1)}px, ${py.toFixed(1)}px)`;

          if (!show && h.open) setOpen(h, false); // the dot left the frame, so does its card

          if (h.open || h.lore.classList.contains('is-open')) {
            const c = layoutCard(h, px, py, t.depth);
            h.lore.style.width = `${c.w.toFixed(1)}px`;
            h.lore.style.transform = `translate3d(${c.x.toFixed(1)}px, ${c.y.toFixed(1)}px, 0)`;
            h.pose.style.transform = `perspective(900px) rotateY(${c.ry.toFixed(2)}deg) rotateX(${c.rx.toFixed(2)}deg)`;
            h.pop.style.transformOrigin = `${(px - c.x).toFixed(1)}px ${(py - c.y).toFixed(1)}px`;
            h.pop.style.setProperty('--pop-spin', `${c.ry >= 0 ? 40 : -40}deg`);

            // Connector from the dot to the nearest point on the card.
            const ex = Math.min(Math.max(px, c.x), c.x + c.w);
            const ey = Math.min(Math.max(py, c.y), c.y + c.ht);
            const dx = ex - px;
            const dy = ey - py;
            h.line.style.left = `${(px - c.x).toFixed(1)}px`;
            h.line.style.top = `${(py - c.y).toFixed(1)}px`;
            h.line.style.width = `${Math.hypot(dx, dy).toFixed(1)}px`;
            h.line.style.transform = `rotate(${Math.atan2(dy, dx).toFixed(4)}rad)`;
          }

          const passed = index >= h.index;
          if (passed !== h.passed) {
            h.passed = passed;
            h.dot.classList.toggle('is-passed', passed);
            h.stop.classList.toggle('is-passed', passed);
          }
        }
      }

      function updateHud(index: number) {
        const n = manifest.frames.length;
        const size = manifest.variants[variant];
        const passed = hotspots.filter((h) => h.passed).length;
        const keys = Object.keys(hotspotFile?.frames ?? {}).map(Number);
        const lastKey = keys.length ? Math.max(...keys) : -1;
        const stale = keys.length && lastKey < Number(manifest.frames[n - 1]);
        hud.innerHTML =
          `<b>frame </b>${manifest.frames[index]} <b>(${index + 1}/${n})</b>\n` +
          `<b>scroll </b>${(progress * 100).toFixed(1)}%\n` +
          `<b>fetched </b>${blobCount}/${n} <b>decoded </b>${bitmaps.size}\n` +
          `<b>${variant} ${size?.width ?? '?'}w</b>\n` +
          `<b>hotspots </b>${hotspotFile ? `${passed}/${hotspots.length} passed` : 'no hotspots.json'}` +
          (stale ? `\n<b>! hotspots.json ends f${lastKey} — re-export</b>` : '');
      }

      function tick() {
        const n = manifest.frames.length;
        const target = progress * (n - 1);
        if (reduceMotion.matches || Math.abs(target - current) < 0.01) current = target;
        else current += (target - current) * SMOOTHING;

        const index = Math.min(n - 1, Math.max(0, Math.round(current)));
        lastIndex = index;
        pump(index);

        if (index !== drawn || dirty) {
          // Until a frame has painted there's no picture to pin hotspots to.
          if (draw(index)) {
            drawn = index;
            dirty = false;
          }
        }
        updateHotspots(index);
        railFill.style.transform = `scaleY(${(current / (n - 1)).toFixed(4)})`;
        updateHud(index);
        requestAnimationFrame(tick);
      }

      // -------- rail dragging --------

      function scrubTo(clientY: number) {
        const rect = rail.getBoundingClientRect();
        scrollToProgress(Math.min(1, Math.max(0, (clientY - rect.top) / rect.height)));
      }
      rail.addEventListener('pointerdown', (e) => {
        rail.setPointerCapture(e.pointerId);
        scrubTo(e.clientY);
      });
      rail.addEventListener('pointermove', (e) => {
        if (rail.hasPointerCapture(e.pointerId)) scrubTo(e.clientY);
      });

      // -------- film grain --------
      // Noise is generated once into a few small tiles. Each "frame" of grain just tiles one of them
      // across a physical-pixel canvas at a random offset, at film cadence rather than every rAF.

      const GRAIN = { opacity: 0.19, size: 1, fps: 18, blend: 'hard-light' }; // size = physical px per noise px
      const GRAIN_TILE = 256;
      const GRAIN_TILES = 8;
      const grainCanvas = $('grain') as HTMLCanvasElement;
      const gctx = grainCanvas.getContext('2d')!;
      const grainTiles: HTMLCanvasElement[] = [];
      let grainRaf = 0;
      let grainLast = 0;
      let grainIndex = 0;

      function makeGrainTiles() {
        const n = GRAIN_TILE;
        for (let t = 0; t < GRAIN_TILES; t++) {
          // Gaussian-ish noise (sum of uniforms), then a light wrapped blur so it clumps like silver
          // halide rather than TV static. Wrapping keeps each tile seamless.
          const raw = new Float32Array(n * n);
          for (let i = 0; i < raw.length; i++) raw[i] = Math.random() + Math.random() + Math.random() + Math.random() - 2;
          const soft = new Float32Array(n * n);
          for (let y = 0; y < n; y++) {
            for (let x = 0; x < n; x++) {
              const xm = (x + n - 1) % n;
              const xp = (x + 1) % n;
              const ym = (y + n - 1) % n;
              const yp = (y + 1) % n;
              soft[y * n + x] =
                (raw[y * n + x] * 4 + raw[y * n + xm] + raw[y * n + xp] + raw[ym * n + x] + raw[yp * n + x]) / 8;
            }
          }
          const c = document.createElement('canvas');
          c.width = c.height = n;
          const cctx = c.getContext('2d')!;
          const img = cctx.createImageData(n, n);
          for (let i = 0; i < soft.length; i++) {
            // Luminance only: R=G=B, centred on mid-grey (neutral for soft-light/overlay).
            const v = Math.max(0, Math.min(255, 128 + soft[i] * 95));
            img.data[i * 4] = img.data[i * 4 + 1] = img.data[i * 4 + 2] = v;
            img.data[i * 4 + 3] = 255;
          }
          cctx.putImageData(img, 0, 0);
          grainTiles.push(c);
        }
      }

      function sizeGrain() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        grainCanvas.width = Math.round(window.innerWidth * dpr);
        grainCanvas.height = Math.round(window.innerHeight * dpr);
      }

      function drawGrain(index: number, still = false) {
        const w = grainCanvas.width;
        const h = grainCanvas.height;
        const foot = GRAIN_TILE * GRAIN.size; // on-screen tile size, physical px
        const ox = still ? 0 : -Math.random() * foot;
        const oy = still ? 0 : -Math.random() * foot;
        gctx.imageSmoothingEnabled = GRAIN.size % 1 !== 0; // crisp at whole sizes, soft otherwise
        const tile = grainTiles[index];
        for (let r = 0; oy + r * foot < h; r++) {
          const y0 = Math.round(oy + r * foot);
          const y1 = Math.round(oy + (r + 1) * foot);
          for (let c = 0; ox + c * foot < w; c++) {
            const x0 = Math.round(ox + c * foot);
            const x1 = Math.round(ox + (c + 1) * foot);
            gctx.drawImage(tile, x0, y0, x1 - x0, y1 - y0); // opaque tiles, so no clear needed
          }
        }
      }

      function grainLoop(now: number) {
        grainRaf = requestAnimationFrame(grainLoop);
        if (now - grainLast < 1000 / GRAIN.fps - 2) return;
        grainLast = now;
        grainIndex = (grainIndex + 1) % GRAIN_TILES;
        drawGrain(grainIndex);
      }

      function applyGrain() {
        grainCanvas.style.opacity = String(GRAIN.opacity);
        grainCanvas.style.mixBlendMode = GRAIN.blend;
        if (reduceMotion.matches) drawGrain(0, true); // size changed → repaint the static tile
      }

      function startGrain() {
        cancelAnimationFrame(grainRaf);
        grainRaf = 0;
        if (reduceMotion.matches) {
          drawGrain(0, true); // one static tile, no animation
        } else if (!document.hidden) {
          grainRaf = requestAnimationFrame(grainLoop);
        }
      }

      makeGrainTiles();
      sizeGrain();
      applyGrain();
      startGrain();
      document.addEventListener('visibilitychange', startGrain);
      reduceMotion.addEventListener('change', startGrain);
      window.addEventListener('resize', () => {
        sizeGrain();
        drawGrain(grainIndex, reduceMotion.matches);
      });

      // -------- boot --------

      async function init() {
        const res = await fetch(`${ROOT}/frames/manifest.json`);
        if (!res.ok) {
          hud.textContent = 'No frames found.\nRun: node scripts/convert-frames.mjs';
          return;
        }
        manifest = await res.json();

        // Optional — the page still scrubs fine without hotspots.
        hotspotFile = await fetch(`${ROOT}/hotspots.json`)
          .then((r) => (r.ok ? r.json() : null))
          .catch(() => null);

        buildHotspots();

        const pick = () => (mobileQuery.matches ? 'mobile' : 'desktop');
        variant = pick();
        resize();
        readProgress();
        current = progress * (manifest.frames.length - 1);
        lastIndex = Math.round(current);

        mobileQuery.addEventListener('change', () => startLoading(pick()));
        window.addEventListener('scroll', readProgress, { passive: true });
        window.addEventListener('resize', () => {
          resize();
          readProgress();
        });

        startLoading(variant);
        requestAnimationFrame(tick);
      }

      init();
    </script>
  </body>
</html>
